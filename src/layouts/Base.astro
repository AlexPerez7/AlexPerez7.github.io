---
import '../styles/global.css';
import { site } from '../data/site';
import ThemeToggle from '../components/ThemeToggle.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title?: string;
  description?: string;
  /** Imagen para redes sociales (ruta o URL absoluta) */
  image?: string;
  /** Texto alternativo de la imagen social (por defecto: nombre y cargo) */
  imageAlt?: string;
  /** Palabras clave de la página (opcional) */
  keywords?: string;
  /** 'article' en páginas de proyecto, 'website' en el resto */
  type?: 'website' | 'article';
  /** Excluye la página de buscadores (p. ej. la 404) */
  noindex?: boolean;
}

const {
  title,
  description = site.tagline,
  image = '/og.png',
  imageAlt = `${site.name}, ${site.role}`,
  keywords,
  type = 'website',
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role} | ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Datos estructurados: ayudan a Google a mostrar nombre, cargo y perfiles
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: Astro.site?.href,
  image: new URL(site.avatar, Astro.site).href,
  email: `mailto:${site.email}`,
  worksFor: { '@type': 'Organization', name: site.company },
  address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' },
  sameAs: site.social.map((s) => s.href),
};

const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/proyectos/', label: 'Proyectos' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0a09" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      // Antes de pintar: marca que hay JS y aplica el tema guardado o el del sistema.
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <header class="site-header">
      <div class="container bar">
        <!-- El nombre accesible es siempre el nombre completo; en móvil se ve el monograma -->
        <a href="/" class="logo">
          <span class="logo-full">{site.shortName}</span>
          <span class="logo-short" aria-hidden="true">
            AP
          </span>
        </a>
        <nav aria-label="Principal">
          {nav.map((item) => (
            <a
              href={item.href}
              data-astro-prefetch
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
              {isActive(item.href) && <span class="indicator" aria-hidden="true" />}
            </a>
          ))}
        </nav>
        <CommandPalette />
        <ThemeToggle />
      </div>
    </header>

    <noscript>
      <p class="noscript-note container">
        La búsqueda (Ctrl K) y el cambio de tema necesitan JavaScript; el resto del sitio funciona
        sin él.
      </p>
    </noscript>

    <main id="contenido" class="container" tabindex="-1">
      <slot />
    </main>

    <footer class="container">
      <p>
        © {new Date().getFullYear()} {site.name}
      </p>
      <div>
        {site.social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener">
            {s.label}
          </a>
        ))}
      </div>
    </footer>

    <script>
      // Muestra cada .reveal una sola vez cuando entra en pantalla.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.setAttribute('data-visible', '');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style>
  /* Solo aparece al navegar con teclado (Tab) */
  .skip-link {
    position: fixed;
    top: calc(env(safe-area-inset-top) + 0.5rem);
    left: 0.5rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: 10px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
    translate: 0 -200%;
    transition: translate 150ms var(--ease-out);
  }
  .skip-link:focus {
    translate: none;
  }
  main:focus {
    outline: none;
  }

  /* Aviso para quien navega sin JavaScript (solo se ve entonces) */
  .noscript-note {
    margin: 0;
    padding-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .site-header {
    view-transition-name: site-header;
    position: sticky;
    top: 0;
    z-index: 10;
    padding-top: env(safe-area-inset-top);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: 3.75rem;
  }
  .logo {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.5rem 0;
  }
  .logo-short {
    display: none;
  }
  nav {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }
  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.6rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    nav a:hover {
      color: var(--text);
    }
  }
  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
  }
  /* Indicador de sección activa: se desliza entre enlaces al cambiar de página */
  .indicator {
    view-transition-name: nav-indicator;
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 6px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  /* Celulares: monograma en vez del nombre para que quepan menú y selector */
  @media (max-width: 440px) {
    .logo-full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .logo-short {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--accent);
      color: var(--bg);
      font-size: 0.8rem;
      letter-spacing: 0.02em;
    }
    .bar {
      gap: 0.25rem;
    }
    nav {
      gap: 0;
    }
    nav a {
      padding: 0 0.5rem;
    }
    .indicator {
      left: 0.5rem;
      right: 0.5rem;
    }
  }
  @media (max-width: 350px) {
    nav a {
      padding: 0 0.35rem;
      font-size: 0.9rem;
    }
    .indicator {
      left: 0.35rem;
      right: 0.35rem;
    }
  }

  main {
    min-height: 70vh;
    padding-bottom: 4rem;
  }
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    color: var(--muted);
    font-size: 0.9rem;
  }
  /* Línea superior como primera fila del flex: queda alineada con el contenido, no con el padding */
  footer::before {
    content: '';
    flex-basis: 100%;
    height: 1px;
    margin-bottom: 0.5rem;
    background: var(--border);
  }
  footer p {
    margin: 0;
  }
  footer div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin-left: -0.25rem;
  }
  footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.25rem;
  }
</style>
