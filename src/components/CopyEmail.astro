---
// Botón que copia el email al portapapeles, con confirmación animada.
// Si el portapapeles no está disponible, abre el cliente de correo.
interface Props {
  email: string;
  class?: string;
}

const { email, class: className } = Astro.props;
---

<button type="button" class:list={['btn', 'secondary', 'copy-email', className]} data-email={email}>
  <span class="icons" aria-hidden="true">
    <svg class="icon copy" viewBox="0 0 24 24">
      <rect x="9" y="9" width="11" height="11" rx="2" />
      <path d="M5 15V6a2 2 0 0 1 2-2h9" />
    </svg>
    <svg class="icon check" viewBox="0 0 24 24">
      <path d="M5 12.5l4.5 4.5L19 7.5" />
    </svg>
  </span>
  <span class="labels">
    <span class="label idle">Copiar email</span>
    <span class="label done" aria-hidden="true">
      ¡Copiado!
    </span>
  </span>
  <span class="sr-only" aria-live="polite"></span>
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-email')) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    const live = button.querySelector('[aria-live]')!;
    button.addEventListener('click', async () => {
      const email = button.dataset.email!;
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        location.href = `mailto:${email}`;
        return;
      }
      button.dataset.copied = '';
      live.textContent = `Email ${email} copiado al portapapeles`;
      clearTimeout(timer);
      timer = setTimeout(() => {
        delete button.dataset.copied;
        live.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .copy-email {
    gap: 0.5rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      border-color 200ms ease,
      color 200ms ease;
  }
  .copy-email:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .copy-email[data-copied] {
    --success: light-dark(#047857, #34d399);
    border-color: var(--success);
    color: var(--success);
  }

  /* Íconos y textos apilados: el botón no cambia de ancho al confirmar */
  .icons,
  .labels {
    display: inline-grid;
  }
  .icons > *,
  .labels > * {
    grid-area: 1 / 1;
  }

  .icon {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }
  .check {
    opacity: 0;
    transform: scale(0.5);
  }
  .label {
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  [data-copied] .copy {
    opacity: 0;
    transform: scale(0.5);
  }
  [data-copied] .check {
    opacity: 1;
    transform: none;
  }
  [data-copied] .label.idle {
    opacity: 0;
    transform: translateY(-6px);
  }
  .label.done {
    opacity: 0;
    transform: translateY(6px);
  }
  [data-copied] .label.done {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .icon,
    .label {
      transition: opacity 150ms ease;
      transform: none !important;
    }
  }
</style>
