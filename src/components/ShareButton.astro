---
// Botón para compartir el proyecto. En móvil usa la hoja nativa (navigator.share);
// si no está disponible, copia el enlace al portapapeles.
interface Props {
  url: string;
  title: string;
  class?: string;
}

const { url, title, class: className } = Astro.props;
---

<button
  type="button"
  class:list={['btn', 'secondary', 'share', className]}
  data-url={url}
  data-title={title}
>
  <span class="icons" aria-hidden="true">
    <svg class="icon share-icon" viewBox="0 0 24 24">
      <circle cx="18" cy="5" r="3" />
      <circle cx="6" cy="12" r="3" />
      <circle cx="18" cy="19" r="3" />
      <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" />
    </svg>
    <svg class="icon check" viewBox="0 0 24 24">
      <path d="M5 12.5l4.5 4.5L19 7.5" />
    </svg>
  </span>
  <span class="labels">
    <span class="label idle">Compartir</span>
    <span class="label done" aria-hidden="true">
      ¡Enlace copiado!
    </span>
  </span>
  <span class="sr-only" aria-live="polite"></span>
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.share')) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    const live = button.querySelector('[aria-live]')!;
    button.addEventListener('click', async () => {
      const { url, title } = button.dataset;
      if (!url) return;
      // Móvil y navegadores compatibles: hoja de compartir del sistema
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch {
          // El usuario canceló: no hacemos nada
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        location.href = url;
        return;
      }
      button.dataset.copied = '';
      live.textContent = 'Enlace copiado al portapapeles';
      clearTimeout(timer);
      timer = setTimeout(() => {
        delete button.dataset.copied;
        live.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .share {
    gap: 0.5rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      border-color 200ms ease,
      color 200ms ease;
  }
  .share:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .share[data-copied] {
    --success: light-dark(#047857, #34d399);
    border-color: var(--success);
    color: var(--success);
  }

  /* Íconos y textos apilados: el botón no cambia de ancho al confirmar */
  .icons,
  .labels {
    display: inline-grid;
  }
  .icons > *,
  .labels > * {
    grid-area: 1 / 1;
  }

  .icon {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }
  .check {
    opacity: 0;
    transform: scale(0.5);
  }
  .label {
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  [data-copied] .share-icon {
    opacity: 0;
    transform: scale(0.5);
  }
  [data-copied] .check {
    opacity: 1;
    transform: none;
  }
  [data-copied] .label.idle {
    opacity: 0;
    transform: translateY(-6px);
  }
  .label.done {
    opacity: 0;
    transform: translateY(6px);
  }
  [data-copied] .label.done {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .icon,
    .label {
      transition: opacity 150ms ease;
      transform: none !important;
    }
  }
</style>
