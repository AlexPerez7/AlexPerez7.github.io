---
// Botón para alternar entre modo claro y oscuro.
// El tema inicial lo aplica el script inline del <head> en Base.astro (evita el parpadeo).
---

<button type="button" class="theme-toggle" aria-label="Cambiar tema">
  <!-- Luna: se ve en modo claro (pasa a oscuro) -->
  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
  <!-- Sol: se ve en modo oscuro (pasa a claro) -->
  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const colors = { light: '#fafaf9', dark: '#0c0a09' };

  const current = () => (root.dataset.theme === 'dark' ? 'dark' : 'light');

  function sync() {
    const theme = current();
    button.setAttribute(
      'aria-label',
      theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro',
    );
    document
      .querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')
      .forEach((meta) => (meta.content = colors[theme]));
  }

  function apply(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {}
    sync();
  }

  button.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!document.startViewTransition || reduce) {
      apply(next);
      return;
    }

    // El nuevo tema se expande en círculo desde el botón
    const { left, top, width, height } = button.getBoundingClientRect();
    const x = left + width / 2;
    const y = top + height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    root.classList.add('theme-switching');
    const transition = document.startViewTransition(() => apply(next));
    transition.ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        {
          duration: 450,
          easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
          pseudoElement: '::view-transition-new(root)',
        },
      );
    });
    transition.finished.finally(() => root.classList.remove('theme-switching'));
  });

  // Si el usuario no eligió tema, sigue los cambios del sistema
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {}
    if (stored) return;
    root.dataset.theme = e.matches ? 'dark' : 'light';
    sync();
  });

  sync();
</script>

<style>
  /* Sin JS el botón no haría nada: solo se muestra si hay JS */
  .theme-toggle {
    display: none;
  }
  :global(.js) .theme-toggle {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition:
      transform 160ms var(--ease-out),
      border-color 150ms ease,
      background-color 150ms ease;
  }
  /* Área táctil de 44px aunque el botón mida 40px */
  .theme-toggle::before {
    content: '';
    position: absolute;
    inset: -2px;
  }
  .theme-toggle:active {
    transform: scale(0.92);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover {
      border-color: var(--accent);
      background: var(--accent-soft);
    }
  }

  .icon {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 200ms var(--ease-out),
      transform 250ms var(--ease-out);
  }

  /* Por defecto (modo claro) se ve la luna */
  .sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global([data-theme='dark']) .moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  :global([data-theme='dark']) .sun {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .icon {
      transition: opacity 150ms ease;
    }
    .sun,
    :global([data-theme='dark']) .moon {
      transform: none;
    }
  }
</style>
