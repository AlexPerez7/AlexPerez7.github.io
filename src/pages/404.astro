---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="La página que buscas no existe." noindex>
  <section class="not-found">
    <p class="code enter" aria-hidden="true">
      <span class="prompt">~$</span> cd <span id="missing-path">/pagina</span>
    </p>
    <p class="error enter" style="--i: 1" aria-hidden="true">
      bash: cd: No existe el archivo o el directorio
    </p>
    <h1 class="enter" style="--i: 2">
      Error 404
    </h1>
    <p class="lead enter" style="--i: 3">
      Esta página no existe o cambió de dirección. Puedes volver al inicio o revisar mis proyectos.
    </p>
    <div class="actions enter" style="--i: 4">
      <a class="btn" href="/">
        Ir al inicio
      </a>
      <a class="btn secondary" href="/proyectos/">
        Ver proyectos
      </a>
    </div>
  </section>
</Base>

<script>
  // La página es estática: muestra en el navegador la ruta que se intentó abrir
  const el = document.getElementById('missing-path');
  if (el) {
    try {
      el.textContent = decodeURI(location.pathname);
    } catch {
      el.textContent = location.pathname;
    }
  }
</script>

<style>
  .not-found {
    padding: clamp(2.5rem, 10vw, 5rem) 0 2rem;
  }
  .code,
  .error {
    margin: 0;
    font-family: ui-monospace, 'Cascadia Code', 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }
  .prompt {
    color: var(--accent);
    font-weight: 600;
  }
  .error {
    color: var(--muted);
  }
  h1 {
    font-size: clamp(2.25rem, 8vw, 3.25rem);
    margin: 1.5rem 0 0.5rem;
  }
  .lead {
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 46ch;
    margin: 0 0 1.5rem;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
