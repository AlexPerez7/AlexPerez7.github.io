---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCover from '../../components/ProjectCover.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('proyectos')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  // Mismo orden que el listado: "anterior" es el más reciente, "siguiente" el más antiguo
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const { title, description, date, tags, repo, demo } = project.data;
const { Content } = await render(project);
const longDate = date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long' });
const formattedDate = longDate.charAt(0).toUpperCase() + longDate.slice(1);
---

<Base title={title} description={description} type="article" image={`/og/${project.id}.png`}>
  <article>
    <a href="/proyectos/" class="back">← Proyectos</a>
    <ProjectCover project={project} variant="banner" />
    <h1 style={`view-transition-name: project-${project.id}`}>{title}</h1>
    <p class="meta enter" style="--i: 1">{formattedDate}</p>
    <p class="lead enter" style="--i: 2">{description}</p>
    <ul class="tags enter" style="--i: 3">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    {(repo || demo) && (
      <div class="links enter" style="--i: 4">
        {demo && <a class="btn" href={demo} target="_blank" rel="noopener">Ver demo</a>}
        {repo && <a class="btn secondary" href={repo} target="_blank" rel="noopener">Código</a>}
      </div>
    )}
    <div class="content enter" style="--i: 5">
      <Content />
    </div>

    {(prev || next) && (
      <nav class="pager" aria-label="Más proyectos">
        {prev ? (
          <a href={`/proyectos/${prev.id}/`} rel="prev">
            <span class="dir">← Anterior</span>
            <span class="name">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a href={`/proyectos/${next.id}/`} rel="next" class="next">
            <span class="dir">Siguiente →</span>
            <span class="name">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</Base>

<style>
  article { max-width: 68ch; }
  .back { display: inline-flex; align-items: center; min-height: 44px; margin-top: 1rem; text-decoration: none; }
  h1 { font-size: clamp(2rem, 8vw, 2.5rem); margin: 1.5rem 0 0.25rem; width: fit-content; max-width: 100%; }
  .meta { color: var(--muted); margin: 0; }
  .lead { font-size: 1.15rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; }
  .links { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 1.5rem 0; }
  .content { border-top: 1px solid var(--border); margin-top: 2rem; }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-height: 44px;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      transform 120ms var(--ease-out);
  }
  .pager a:active { transform: scale(0.98); }
  .pager .next { grid-column: 2; text-align: right; }
  .dir { font-size: 0.85rem; color: var(--accent); font-weight: 600; }
  .name { font-weight: 600; overflow-wrap: anywhere; }
  @media (hover: hover) and (pointer: fine) {
    .pager a:hover { border-color: var(--accent); }
  }
  @media (max-width: 480px) {
    .pager { grid-template-columns: 1fr; }
    .pager > span { display: none; }
    .pager .next { grid-column: auto; }
  }
</style>
