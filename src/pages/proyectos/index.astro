---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('proyectos')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Proyectos" description="Todos mis proyectos.">
  <h1 class="enter">Proyectos</h1>
  <p class="intro enter" style="--i: 1">Apps web, PWAs, herramientas internas e IA: una selección de lo que he construido.</p>
  <div class="grid">
    {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
  </div>
</Base>

<style>
  h1 { font-size: clamp(2rem, 8vw, 2.5rem); margin: 2rem 0 0.5rem; }
  .intro { color: var(--muted); margin: 0 0 2rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }
</style>
